# Скопируйте в .env и заполните нужное. .env не коммитится (.gitignore).
# run_studio.command подхватывает .env сам; в терминале: set -a; source .env; set +a

# ACE-Step 1.5 (локальный сервер: uv run acestep-api)
ACESTEP_API_URL=http://127.0.0.1:8001
# ключ нужен, только если сервер запущен с авторизацией
ACESTEP_API_KEY=

# Suno через GPTunneL Creative Lab (платно): ключ из личного кабинета GPTunneL
# Вместо переменной ключ можно сохранить кнопкой в интерфейсе в Keychain macOS.
GPTUNNEL_API_KEY=

# Вкладка «Плейлист» (download_playlist.py)
GPTUNNEL_PLAYLIST_URL=
GPTUNNEL_ALBUM_NAME=Suno Playlist

# ── v1.2: публикация и облачные детекторы ИИ ─────────────────────────────
# В приложении всё это вводится в Settings → Publishing / AI Check и хранится в Keychain;
# переменные — запасной путь для движка без приложения. Пустое значение = сервис выключен.

# Telegram: бот от @BotFather, бот — администратор канала; chat id вида @mychannel или -100…
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3: OAuth-клиент типа "Desktop app" в своём Google Cloud проекте.
# Refresh token приложение получает само (кнопка Connect) и кладёт в Keychain.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Sightengine (AI music detection доступна на тарифе Pro и выше)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ACRCloud File Scanning с включённым AI detection
ACRCLOUD_TOKEN=
ACRCLOUD_CONTAINER_ID=
ACRCLOUD_REGION=eu-west-1
